                        { type: "notice", tag: "Notice", title: "自由活動日", emoji: "🍃" },
                        { type: "food", tag: "Dinner", title: "晚餐", desc: "未定", emoji: "🍽️" }
                    ]
                },
                {
                    day: 8, dateLabel: "2026.11.19 Thu", navDate: "11/19", weekday: "Thu", title: "東京返台", location: "東京 → 台北",
                    weather: { high: "17°C", low: "10°C", desc: "晴時多雲", rain: "10%" },
                    events: [
                        { type: "flight", time: "12:40", title: "羽田→松山", flightInfo: { from: "HND 東京羽田", to: "TSA 台北松山", depTime: "12:40", arrTime: "15:50", duration: "3小時10分", fromTerminal: "Terminal 2", toTerminal: "Terminal 1", flightNo: "NH853" }, emoji: "🛫" }
                    ]
                }
            ];

            const getInitialDay = () => {
                const tripDates = ["2026-11-12", "2026-11-13", "2026-11-14", "2026-11-15", "2026-11-16", "2026-11-17", "2026-11-18", "2026-11-19"];
                const today = new Date();
                const todayStr = today.getFullYear() + '-' + String(today.getMonth() + 1).padStart(2, '0') + '-' + String(today.getDate()).padStart(2, '0');
                const matchIndex = tripDates.indexOf(todayStr);
                if (matchIndex !== -1) return matchIndex;
                if (todayStr > tripDates[tripDates.length - 1]) return tripDates.length - 1;
                return 0;
            };

            const [activeDay, setActiveDay] = useState(getInitialDay);
            const currentDayData = schedule[activeDay] || schedule[0];

            // 各天對應座標（東京 / 河口湖・富士 / 熱海）
            const weatherCoords = {
                1: { lat: 35.6812, lon: 139.7671 }, // 東京
                2: { lat: 35.3061, lon: 138.9330 }, // 河口湖・御殿場周邊
                3: { lat: 35.0954, lon: 139.0739 }, // 熱海
                4: { lat: 35.0954, lon: 139.0739 }, // 熱海
                5: { lat: 35.6812, lon: 139.7671 }, // 東京
                6: { lat: 35.6812, lon: 139.7671 }, // 東京
                7: { lat: 35.6812, lon: 139.7671 }, // 東京
                8: { lat: 35.6812, lon: 139.7671 }, // 東京
            };
            const tripDates = { 1: "2026-11-12", 2: "2026-11-13", 3: "2026-11-14", 4: "2026-11-15", 5: "2026-11-16", 6: "2026-11-17", 7: "2026-11-18", 8: "2026-11-19" };

            const [liveWeather, setLiveWeather] = useState({});

            useEffect(() => {
                window.scrollTo(0, 0);
                const day = currentDayData.day;
                if (!day || liveWeather[day]) return;
                const coords = weatherCoords[day];
                const date = tripDates[day];
                if (!coords || !date) return;
                fetch(`https://api.open-meteo.com/v1/forecast?latitude=${coords.lat}&longitude=${coords.lon}&daily=temperature_2m_max,temperature_2m_min,precipitation_probability_max&timezone=Asia%2FTokyo&start_date=${date}&end_date=${date}`)
                    .then(r => r.json())
                    .then(data => {
                        const d = data.daily;
                        if (!d) return;
                        setLiveWeather(prev => ({
                            ...prev,
                            [day]: {
                                high: Math.round(d.temperature_2m_max[0]) + "°C",
                                low: Math.round(d.temperature_2m_min[0]) + "°C",
                                rain: (d.precipitation_probability_max[0] ?? 0) + "%",
                            }
                        }));
                    })
                    .catch(() => {});
            }, [activeDay]);

            const weather = (currentDayData.day && liveWeather[currentDayData.day])
                ? { ...currentDayData.weather, ...liveWeather[currentDayData.day] }
                : currentDayData.weather;

            return (
                <div className="min-h-screen bg-[#EAF2F1] sm:py-8">
                <div className="max-w-md mx-auto min-h-screen sm:min-h-0 pb-12 text-left bg-white sm:shadow-2xl sm:overflow-hidden">
                    {}
                    <div className="relative h-[240px] w-full overflow-hidden">
                        <img src={headerImageUrl} className="w-full h-full object-cover" />
                        <div className="absolute inset-0 bg-gradient-to-t from-[#1E2D3B]/65 via-[#1E2D3B]/5 to-transparent" />
                        <div className="absolute top-4 right-4 text-center" style={{ textShadow: '0 1px 6px rgba(0,0,0,0.35)' }}>
                            <p className="font-kicker text-[9px] font-bold uppercase leading-none text-white">Issue</p>
                            <p className="font-bubble text-xl leading-none mt-1 text-white">2026</p>
                            <p className="font-kicker text-[9px] font-bold uppercase leading-none mt-1 text-white">Autumn</p>
                        </div>
                        <div className="absolute inset-x-0 bottom-0 p-6">
                            <h1 className="font-bubble text-4xl text-white tracking-wide" style={{ textShadow: '0 2px 10px rgba(0,0,0,0.35)' }}>Let's go to FUJI</h1>
                            <svg viewBox="0 0 220 14" className="w-[220px] h-[14px] mt-2">
                                <path d="M3 12 L20 4 L35 10 L55 3 L75 11 L95 4 L115 10.5 L135 3.5 L155 11 L175 4 L195 10 L212 5 L217 8" fill="none" stroke="#4E8A63" strokeWidth="3" strokeLinecap="round" strokeLinejoin="round" />
                            </svg>
                        </div>
                    </div>

                    {}
                    <div className="sticky top-0 z-50 bg-white/95 backdrop-blur-xl border-b-2 border-[#1E2D3B]">
                        <div className="overflow-x-auto no-scrollbar py-3 px-4 flex gap-2">
                            {schedule.map((day, index) => {
                                const active = activeDay === index;
                                return (
                                <button key={index} onClick={() => setActiveDay(index)} className={`flex flex-col items-center justify-center min-w-[58px] px-2 h-16 rounded-2xl border-2 transition-all ${active ? 'bg-[#C0392B] border-[#C0392B] text-white scale-105 shadow-md' : 'bg-white border-[#1E2D3B]/20 text-[#1E2D3B] hover:border-[#1E2D3B]/50'}`}>
                                    <span className="font-kicker text-[9px] font-bold uppercase">{`DAY ${day.day}`}</span>
                                    <span className="font-bubble text-sm font-bold mt-0.5 whitespace-nowrap">{day.navDate}</span>
                                    {day.weekday && <span className={`font-kicker text-[9px] font-bold mt-0.5 ${active ? 'text-white/80' : 'text-[#1E2D3B]/40'}`}>{day.weekday}</span>}
                                </button>
                                );
                            })}
                        </div>
                    </div>

                    {}
                    <main className="px-5 mt-6">
                        <div className="mb-6 animate-fade-in">
                            <div className="flex items-center gap-2 mb-1.5">
                                <svg viewBox="0 0 34 10" className="w-[34px] h-[10px]">
                                    <path d="M2 8 L8 3 L12 6.5 L16 2 L20 6.5 L24 3 L28 6.5 L32 4" fill="none" stroke="#2E6F93" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round" />
                                </svg>
                                <span className="font-kicker text-[#2E6F93] text-xs font-bold uppercase">{currentDayData.location}</span>
                            </div>
                            <h2 className="text-2xl font-black text-[#1E2D3B] leading-snug">{currentDayData.title}</h2>
                            <p className="font-kicker text-[#1E2D3B]/50 font-bold text-xs mt-1 uppercase">{currentDayData.dateLabel}</p>
                        </div>

                        {}
                        <div className="mb-6 animate-fade-in">
                            <div className="bg-[#EAF2F1] rounded-2xl p-4 border border-[#2E6F93]/15">
                                <div className="flex items-center justify-between">
                                    <div className="flex items-center gap-3">
                                        <div className="relative p-2 bg-[#2E6F93] text-white" style={{ borderRadius: '62% 38% 45% 55% / 40% 55% 45% 60%' }}><Icon name="mountain-snow" size={18} /></div>
                                        <div>
                                            <h4 className="font-kicker text-xs font-bold text-[#1E2D3B] uppercase">{weather.desc}</h4>
                                            <p className="text-[11px] font-bold text-[#1E2D3B]/50">降雨機率 {weather.rain}</p>
                                        </div>
                                    </div>
                                    <div className="text-right">
                                        <div className="flex items-baseline gap-1">
                                            <span className="font-kicker text-xl font-bold text-[#1F4E68] tracking-tighter">{weather.high}</span>
                                            <span className="text-[#1E2D3B]/25 font-black mx-0.5">/</span>
                                            <span className="font-kicker text-base font-bold text-[#3A7A5A] tracking-tighter">{weather.low}</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        {}
                        <div className="space-y-4 relative">
                            <div className="absolute top-8 bottom-0 left-[21px] w-0 border-l-2 border-dashed border-[#DCE4E6]" />
                            {currentDayData.events.map((event, idx) => {
                                const style = getTagStyle(event.tag);
                                const isSpecialTime = event.title.includes('★') || event.highlightTime;

                                return (
                                    <div key={`${activeDay}-${idx}`} className="relative pl-12 animate-slide-up" style={{ animationDelay: `${idx * 40}ms` }}>
                                        <div className="absolute left-0 top-0 flex flex-col items-center">
                                            <div className="w-11 h-11 rounded-full bg-white border-2 border-[#1E2D3B]/15 flex items-center justify-center text-xl z-10">{event.emoji}</div>
                                            {event.time && (
                                                <div className={`mt-1.5 px-1.5 py-0.5 rounded-md font-kicker text-white text-[10px] font-bold ${isSpecialTime ? 'bg-[#C0392B]' : 'bg-[#1E2D3B]'}`}>
                                                    {event.time}
                                                </div>
                                            )}
                                        </div>
                                        <div className={`bg-white rounded-2xl p-4 border ${style.border} ${isSpecialTime ? 'ring-1 ring-[#C0392B]/40' : ''}`}>
                                            {event.tag && <div className={`inline-flex items-center gap-1 mb-2 px-2 py-0.5 rounded-md ${style.chip}`}><Icon name={style.icon} size={10} strokeWidth={3} /><span className="font-kicker text-[10px] font-bold uppercase">{event.tag}</span></div>}
                                            <div className="flex justify-between items-start gap-2">
                                                <h3 className="font-black text-[#1E2D3B] text-base leading-tight flex-1">
                                                    {event.title}
                                                </h3>
                                                {event.location && <a href={event.location} target={isMobile ? '_self' : '_blank'} rel="noopener noreferrer" className={`w-8 h-8 rounded-xl flex items-center justify-center shrink-0 ${style.btn}`}><Icon name="navigation" size={16} fill="currentColor" /></a>}
                                                {event.link && <a href={event.link} target="_blank" rel="noopener noreferrer" className="w-8 h-8 rounded-xl flex items-center justify-center shrink-0 bg-[#1E2D3B]/8 text-[#1E2D3B] active:bg-[#1E2D3B] active:text-white"><Icon name="external-link" size={15} strokeWidth={2} /></a>}
                                            </div>

                                            {event.desc && <p className="text-[#1E2D3B]/70 text-sm mt-2 font-medium leading-relaxed whitespace-pre-line">{event.desc}</p>}

                                            {event.type === 'flight' && event.flightInfo && (
                                                <div className="mt-3 bg-[#EAF2F1] rounded-xl p-3 border border-[#2E6F93]/15">
                                                    <div className="text-center font-kicker text-[11px] font-bold text-[#2E6F93] mb-2 uppercase">{event.flightInfo.flightNo || '航班資訊'}</div>
                                                    <div className="flex items-center justify-between gap-1">
                                                        <div className="text-center">
                                                            <div className="font-kicker text-2xl font-bold text-[#1E2D3B] tracking-tight leading-none">{event.flightInfo.depTime}</div>
                                                            <div className="text-xs font-bold text-[#1E2D3B]/60 mt-1">{event.flightInfo.from.split(' ')[1]}</div>
                                                            {event.flightInfo.fromTerminal && <div className="text-[10px] font-bold text-[#C0392B] mt-0.5">{event.flightInfo.fromTerminal}</div>}
                                                        </div>
                                                        <div className="flex flex-col items-center grow px-2">
                                                            {event.flightInfo.duration && <div className="text-[10px] font-bold text-[#3A7A5A] mb-1 whitespace-nowrap">{event.flightInfo.duration}</div>}
                                                            <div className="w-full h-[2px] bg-[#2E6F93]/30 relative">
                                                                <div className="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 bg-[#EAF2F1] px-1.5">
                                                                    <Icon name="plane" size={14} className="text-[#2E6F93] rotate-90" fill="currentColor" />
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div className="text-center">
                                                            <div className="font-kicker text-2xl font-bold text-[#1E2D3B] tracking-tight leading-none">{event.flightInfo.arrTime}</div>
                                                            <div className="text-xs font-bold text-[#1E2D3B]/60 mt-1">{event.flightInfo.to.split(' ')[1]}</div>
                                                            {event.flightInfo.toTerminal && <div className="text-[10px] font-bold text-[#C0392B] mt-0.5">{event.flightInfo.toTerminal}</div>}
                                                        </div>
                                                    </div>
                                                </div>
                                            )}

                                            {event.transitInfo && (
                                                <div className="mt-3 bg-[#EAF2F1] rounded-xl p-3 border border-[#2E6F93]/15">
                                                    {event.transitInfo.train && <div className="text-center font-kicker text-[11px] font-bold text-[#2E6F93] mb-2 uppercase">{event.transitInfo.train}</div>}
                                                    <div className="flex items-center justify-between gap-1">
                                                        <div className="text-center">
                                                            <div className="font-kicker text-2xl font-bold text-[#1E2D3B] tracking-tight leading-none">{event.transitInfo.dep}</div>
                                                            <div className="text-xs font-bold text-[#1E2D3B]/60 mt-1">{event.transitInfo.from}</div>
                                                        </div>
                                                        <div className="flex flex-col items-center grow px-2">
                                                            <div className="text-[10px] font-bold text-[#3A7A5A] mb-1 whitespace-nowrap">{event.transitInfo.duration}</div>
                                                            <div className="w-full h-[2px] bg-[#2E6F93]/30 relative">
                                                                <div className="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 bg-[#EAF2F1] px-1.5">
                                                                    <Icon name="train-front" size={14} className="text-[#2E6F93]" />
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div className="text-center">
                                                            <div className="font-kicker text-2xl font-bold text-[#1E2D3B] tracking-tight leading-none">{event.transitInfo.arr}</div>
                                                            <div className="text-xs font-bold text-[#1E2D3B]/60 mt-1">{event.transitInfo.to}</div>
                                                        </div>
                                                    </div>
                                                </div>
                                            )}

                                            {event.isList && event.options && (
                                                <div className="mt-3 flex flex-col gap-2">
                                                    {event.options.map((opt, i) => {
                                                        const parsed = parseOptionName(opt.name);
                                                        const note = opt.desc || parsed.note;
                                                        return (
                                                            <a key={i} href={opt.url} target={isMobile ? '_self' : '_blank'} rel="noopener noreferrer" className={`flex items-center gap-3 p-3 rounded-xl border text-left transition-all ${style.bg} ${style.border} active:scale-[0.98]`}>
                                                                <div className="min-w-0 flex-1">
                                                                    <div className={`text-sm font-bold leading-snug ${style.text}`}>{parsed.title}</div>
                                                                    {note && <div className="text-xs font-medium text-[#1E2D3B]/50 leading-snug mt-0.5">{note}</div>}
                                                                </div>
                                                                {opt.url && <Icon name="chevron-right" size={14} className={`shrink-0 ${style.text} opacity-60`} />}
                                                            </a>
                                                        );
                                                    })}
                                                </div>
                                            )}

                                            {event.footnote && (
                                                <p className="text-xs font-medium text-[#1E2D3B]/45 leading-relaxed mt-2 whitespace-pre-line">{event.footnote}</p>
                                            )}
                                        </div>
                                    </div>
                                );
                            })}
                        </div>
                    </main>
                </div>
                </div>
            );
        };

        const root = ReactDOM.createRoot(document.getElementById('root'));
        root.render(<TripApp />);

        const splash = document.getElementById('splash');
        if (splash) {
            requestAnimationFrame(() => {
                splash.style.opacity = '0';
                setTimeout(() => splash.remove(), 350);
            });
        }
    </script>
</body>
</html>
